---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from './Figure.module.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  mobileSrc?: ImageMetadata;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
}
const {
  src,
  alt,
  caption,
  mobileSrc,
  widths = [640, 960, 1280, 1920],
  sizes = '(max-width: 48rem) 100vw, 46rem',
  loading = 'lazy',
  priority = false,
}: Props = Astro.props;

const desktop = await getImage({ src, widths, sizes, format: 'webp' });
const mobile = mobileSrc
  ? await getImage({
      src: mobileSrc,
      widths: [390, 780],
      sizes: '100vw',
      format: 'webp',
    })
  : undefined;
const width = desktop.attributes['width'];
const height = desktop.attributes['height'];
---

<figure class={styles['figure']}>
  <picture>
    {mobile && <source media="(max-width: 40rem)" srcset={mobile.srcSet.attribute} sizes="100vw" type="image/webp" />}
    <source srcset={desktop.srcSet.attribute} sizes={sizes} type="image/webp" />
    <img class={styles['image']} src={desktop.src} alt={alt} width={width} height={height} loading={priority ? 'eager' : loading} decoding="async" fetchpriority={priority ? 'high' : undefined} />
  </picture>
  {caption && <figcaption class={styles['caption']}>{caption}</figcaption>}
</figure>

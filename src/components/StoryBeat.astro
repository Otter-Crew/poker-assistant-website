---
import styles from './StoryBeat.module.css';

interface Props {
  title: string;
  description: string;
  label?: string;
  href?: string;
  headingLevel?: 2 | 3;
  media?: 'left' | 'right' | 'none';
}
const {
  title,
  description,
  label,
  href,
  headingLevel = 3,
  media = 'none',
}: Props = Astro.props;
const Title = headingLevel === 2 ? 'h2' : 'h3';
const hasMedia = media !== 'none' && Astro.slots.has('media');
---

<li class:list={[styles['beat'], hasMedia && styles['hasMedia'], media === 'left' && styles['mediaLeft']]}>
  <div class={styles['copy']}>
    {label && <p class="eyebrow">{label}</p>}
    <Title class:list={[styles['title'], headingLevel === 2 && styles['titleLarge']]}>
      {href ? <a class={styles['link']} href={href}>{title}<span class={styles['arrow']} aria-hidden="true">&rarr;</span></a> : title}
    </Title>
    <p class={styles['description']}>{description}</p>
    <slot />
  </div>
  {hasMedia && <div class={styles['media']}><slot name="media" /></div>}
</li>

---
import A1 from '../assets/screens/A1.png';
import P1 from '../assets/screens/P1.png';
import R1 from '../assets/screens/R1.png';
import R2 from '../assets/screens/R2.png';
import S1 from '../assets/screens/S1.png';
import S2 from '../assets/screens/S2.png';
import T2 from '../assets/screens/T2.png';
import ArrowLink from '../components/ArrowLink.astro';
import Faq from '../components/Faq.astro';
import FaqItem from '../components/FaqItem.astro';
import Figure from '../components/Figure.astro';
import ProductHero from '../components/ProductHero.astro';
import Section from '../components/Section.astro';
import SectionMarker from '../components/SectionMarker.astro';
import StillSequence from '../components/StillSequence.astro';
import StoryBeat from '../components/StoryBeat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import styles from './index.module.css';
---

<BaseLayout>
  <ProductHero eyebrow="Otter Crew's Poker Assistant" title="Find your leaks. Build a better game." lede="Free forever: complete heads-up GTO, on your device. Review your hands, train the spots that cost you, and solve the questions no chart can answer. No account. No uploads. No subscription.">
    <Fragment slot="actions">
      <ArrowLink href="/how-it-works" size="lede">See how it works</ArrowLink>
      <ArrowLink href="/solutions" tone="muted">What's free</ArrowLink>
      <p class={styles['platform']}>Coming soon to iPadOS, macOS and Android.</p>
    </Fragment>
    <Fragment slot="media">
      <Figure src={S1} alt="Screenshot of the Study screen: a range grid with a fold-heavy first-to-act strategy and an action ladder showing raise sizes and frequencies." caption="6-max, 100bb, first to act. The solver opens about a sixth of hands and mixes three raise sizes." priority sizes="(max-width: 48rem) 100vw, 58vw" />
    </Fragment>
  </ProductHero>

  <Section top="lg" bottom="xl" labelledby="what">
    <SectionMarker id="what" as="h2">Everything you need to get better</SectionMarker>
    <ol class={styles['beats']} role="list">
      <StoryBeat title="Turn every session into a leak report" description="Import hands from PokerStars, GGPoker, 888poker, Winamax or iPoker. Poker Assistant grades every decision, ranks your biggest EV losses, and takes you straight to the hands worth fixing." media="right">
        <Figure slot="media" src={A1} alt="Screenshot of the Analyze hand list sorted by EV loss, with the biggest loss at the top and each row showing site, position, cards and result." caption="A session of forty hands, sorted by EV lost. The top row is the one to study." />
      </StoryBeat>
      <StoryBeat title="See the best play instantly" description="Every one of the 169 starting hands is mapped to its exact strategy. Switch between action, EV and equity to see what to do, what it earns, and how close the alternatives really are." media="left">
        <Figure slot="media" src={S2} alt="Screenshot of the Study screen: a range grid for a button facing a three-bet, with a fold-heavy strategy and a four-option action ladder." caption="BTN facing an 8bb three-bet from the BB. Every pair from 22 up calls; only the strongest hands raise back." />
      </StoryBeat>
      <StoryBeat title="Train the mistakes out of your game" description="Practice deals real solved spots, grades your answer, and shows the EV you missed. Tough spots return as drills, so every session targets the leaks you actually have." media="right">
        <Figure slot="media" src={T2} alt="Screenshot of the Practice screen with a hand's revealed mix and grade after answering." caption="A4 offsuit at the cutoff splits three raise sizes; the pick misses top choice by a hundredth of a big blind." />
      </StoryBeat>
      <StoryBeat title="Make exploits with proof" description="Lock in a real tendency, such as an opponent who folds too often, and re-solve the spot. See the counter-strategy, the EV it gains, and exactly what a bad read costs." media="none" />
      <StoryBeat title="Heads-up GTO is free. Forever." description="Every heads-up preflop solution from 8bb to 200bb is included: ante, rake and straddle structures too. Need bigger tables? Buy the pack that fits your game once and keep it." media="right">
        <ArrowLink href="/solutions">See coverage and what's free</ArrowLink>
        <Figure slot="media" src={P1} alt="Screenshot of the installed packs list showing six packs with their coverage and sizes, from a 5 MB push/fold pack to a 763 MB core pack." caption="Installed packs. Heads-up is 7 MB and included. Core, 3 to 6 handed at 15 to 100bb, is 763 MB." />
      </StoryBeat>
      <li class={styles['panel']}>
        <h3>100% local. Completely private.</h3>
        <p>Your hand histories, practice results and study sessions stay on your tablet or Mac. No account. No cloud. No one - not even us - sees what you study.</p>
        <ArrowLink href="/privacy">Read the privacy statement</ArrowLink>
      </li>
      <StoryBeat title="Solve the spot in front of you" description="Deal any flop from a preflop line and get a fresh solve on your device. Explore the exact board, run it through the turn and river, and see the full strategy as it settles." media="left">
        <ArrowLink href="/accuracy">How accurate is it</ArrowLink>
        <StillSequence slot="media" frames={[{ src: R1, alt: 'Screenshot of a flop resolve running on the Study screen, with the iteration count climbing before any strategy renders.', label: 'Solving' }, { src: R2, alt: 'Screenshot of the same flop resolved, with a full betting ladder and a painted range grid filling in.', label: 'Solved' }]} caption="A king-high flop resolves live, then locks in a six-way betting ladder in the same window." />
      </StoryBeat>
    </ol>
  </Section>

  <Section top="xl" bottom="xl" width="content" labelledby="questions">
    <SectionMarker id="questions" as="h2">The important details</SectionMarker>
    <Faq>
      <FaqItem question="Do my hands ever leave my device?"><p>Never. Everything stays on your tablet or Mac. There is no account, no cloud and no server behind the app.</p></FaqItem>
      <FaqItem question="What is free, exactly?"><p>The app and every heads-up solution: 8bb to 200bb, including ante, rake and straddle structures. Train, import hands, node lock and build your own preflop solves with no cap.</p></FaqItem>
      <FaqItem question="Will heads-up stay free?"><p>Yes. It is a permanent part of Poker Assistant. No end date, no daily limit, no subscription.</p></FaqItem>
      <FaqItem question="Can I use it while I play?"><p>No. Poker Assistant is built for study away from the table. Using real-time assistance breaks major poker sites' rules and can cost you your account.</p></FaqItem>
    </Faq>
    <p class={styles['faqLink']}><ArrowLink href="/faq">All questions</ArrowLink></p>
  </Section>

  <Section top="xl" bottom="2xl" width="content" labelledby="closing">
    <SectionMarker id="closing" as="h2">Your next edge starts with one hand</SectionMarker>
    <div class={styles['closing']}>
      <p>Find the mistake. See the answer. Drill it until it disappears.</p>
      <ArrowLink href="/how-it-works" size="lede">See how it works</ArrowLink>
    </div>
  </Section>
</BaseLayout>
